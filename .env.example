# NAVER
NAVER_CLIENT_ID=your-client-id
NAVER_CLIENT_SECRET=your-client-secret


# GCP / Vertex AI
GOOGLE_CLOUD_PROJECT=your-project-id

GOOGLE_CLOUD_LOCATION=us-central1

# ffmpeg
FFMPEG_PATH=ffmpeg

# Temp storage
TEMP_DIR=/tmp/book-trailer-ai
KEEP_TEMP=false

# Models
GEMINI_MODEL=gemini-2.5-flash-lite
VEO_MODEL=veo-3.0-fast-generate-001

# Trailer defaults
DEFAULT_TOP_N_BOOKS=5
DEFAULT_MAX_SYNOPSIS_PAGES=8
DEFAULT_CRAWL_TIMEOUT_SEC=15
DEFAULT_CUT_COUNT=8
DEFAULT_CLIP_DURATION_SECONDS=4
DEFAULT_FPS=24
DEFAULT_ASPECT_RATIO=9:16
DEFAULT_RESOLUTION=720p
DEFAULT_TARGET_SECONDS=32
NARRATION_BASE_CHARS_PER_SEC=11
NARRATION_MAX_SPEAKING_RATE=1.3
